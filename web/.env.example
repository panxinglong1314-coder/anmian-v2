# Backend origin for production builds (leave empty in dev — Vite proxies /api).
# VITE_API_BASE=https://sleepai.chat

# Dev proxy target (defaults to https://sleepai.chat). Override to hit a local backend:
# VITE_API_TARGET=http://127.0.0.1:8000

# Google Sign-In Web OAuth Client ID. Empty → "Continue with Google" button hidden.
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
