/* pages/feedback/feedback.wxss */
.page {
  min-height: 100vh;
  background-color: #0D1B2A;
  padding: 0 24rpx 60rpx;
}

.feedback-container {
  padding-top: 48rpx;
}

.feedback-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}
.feedback-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
.feedback-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #F5C869;
  margin-bottom: 8rpx;
}
.feedback-sub {
  font-size: 26rpx;
  color: #8BA3B9;
}

.feedback-card {
  background: rgba(26, 48, 74, 0.5);
  border: 1rpx solid rgba(139, 163, 185, 0.12);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.feedback-textarea {
  width: 100%;
  height: 320rpx;
  font-size: 28rpx;
  color: #EDE8DF;
  line-height: 1.7;
  background: transparent;
  border: none;
  outline: none;
}
.feedback-count {
  text-align: right;
  font-size: 22rpx;
  color: #5A7A9A;
  margin-top: 12rpx;
}

.feedback-hint {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: rgba(139, 163, 185, 0.05);
  border-radius: 12rpx;
  margin-bottom: 40rpx;
}
.feedback-hint-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}
.feedback-hint-text {
  font-size: 24rpx;
  color: #6B8BA5;
}

.feedback-submit {
  margin-bottom: 32rpx;
}
.feedback-submit-btn {
  display: block;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: rgba(139, 163, 185, 0.15);
  color: #5A7A9A;
  border: 1rpx solid rgba(139, 163, 185, 0.1);
}
.feedback-submit-btn.active {
  background: #F5C869;
  color: #0D1B2A;
  border-color: #F5C869;
}

.feedback-success {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx;
}
.success-icon {
  font-size: 56rpx;
}
.success-text {
  font-size: 28rpx;
  color: #7EC8A3;
}