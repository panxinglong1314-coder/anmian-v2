<!-- pages/feedback/feedback.wxml -->
<view class="page">
  <view class="feedback-container">
    <view class="feedback-header">
      <text class="feedback-icon">💬</text>
      <text class="feedback-title">意见反馈</text>
      <text class="feedback-sub">你的反馈是我们进步的动力</text>
    </view>

    <view class="feedback-card">
      <textarea
        class="feedback-textarea"
        placeholder="请描述你遇到的问题或建议..."
        maxlength="500"
        bindinput="onInput"
        value="{{feedbackText}}"
      ></textarea>
      <view class="feedback-count">{{feedbackText.length || 0}}/500</view>
    </view>

    <view class="feedback-hint">
      <text class="feedback-hint-icon">💡</text>
      <text class="feedback-hint-text">你可以反馈：功能问题、体验建议、新功能请求等</text>
    </view>

    <view class="feedback-submit" bindtap="submitFeedback">
      <text class="feedback-submit-btn {{feedbackText.length > 0 ? 'active' : ''}}">提交反馈</text>
    </view>

    <view wx:if="{{submitted}}" class="feedback-success">
      <text class="success-icon">✓</text>
      <text class="success-text">感谢你的反馈！</text>
    </view>
  </view>
</view>